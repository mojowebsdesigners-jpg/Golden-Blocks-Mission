# ─────────────────────────────────────────────────────────────────────────
# Golden Blocks Mission — environment variables
# Copy to .env.local for local development; set the same keys in Vercel →
# Project → Settings → Environment Variables for production.
#
# Variables prefixed VITE_ are bundled into the browser and MUST be public.
# Everything else is read ONLY by the serverless functions in /api.
# ─────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash) — used for canonical URLs, sitemap and payment callbacks
VITE_SITE_URL=https://goldenblocksmission.org
SITE_URL=https://goldenblocksmission.org

# ── Supabase (Project Settings → API) ────────────────────────────────────
# Public (safe in the browser; access is enforced by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Server only — NEVER prefix with VITE_, never commit
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── M-Pesa Daraja (https://developer.safaricom.co.ke) ────────────────────
MPESA_ENV=sandbox                       # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                  # Paybill (or Buy Goods store number); 174379 is the sandbox shortcode
MPESA_PASSKEY=                          # Lipa Na M-Pesa Online passkey
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline
MPESA_TILL_NUMBER=                      # only for Buy Goods (PartyB)
MPESA_CALLBACK_SECRET=                  # long random string; generate with: openssl rand -hex 32
MPESA_CALLBACK_BASE_URL=                # optional override, e.g. an ngrok URL during local testing

# ── Paystack — card payments (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Webhook URL to register in Paystack: https://YOUR-DOMAIN/api/donations/paystack/webhook

# ── Confirmation emails (optional, https://resend.com) ───────────────────
RESEND_API_KEY=
EMAIL_FROM="Golden Blocks Mission <giving@your-verified-domain.org>"
